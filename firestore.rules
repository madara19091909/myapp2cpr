rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validSave(data) {
      return data.keys().hasOnly([
        'name', 'money', 'gold', 'xp', 'level', 'seeds', 'harvestedCrops',
        'animals', 'animalFeed', 'waterUnits', 'boostedCycles', 'tools',
        'buildings', 'decor', 'products', 'activeCrafts', 'transactions',
        'lastDailyRewardDate', 'dailyStreak', 'lastLuckyDate', 'luckyStreak',
        'insuranceUntil', 'dailyProgressDate', 'dailyProgress',
        'claimedDailyMissions', 'lifetimeStats', 'claimedAchievements',
        'lastActiveAt', 'collect', 'plots', 'updated', 'legacyUnverified',
        'legacyImportedAt', 'lastOfflineRewardMessage'
      ])
      && data.name is string && data.name.size() > 0 && data.name.size() <= 24
      && data.money is int && data.money >= 0 && data.money <= 2000000000
      && data.gold is int && data.gold >= 0 && data.gold <= 1000000
      && data.xp is int && data.xp >= 0 && data.xp <= 1000000000
      && data.level is int && data.level >= 1 && data.level <= 1000000
      && data.seeds is map && data.seeds.size() <= 100
      && data.harvestedCrops is map && data.harvestedCrops.size() <= 100
      && data.animals is map && data.animals.size() <= 100
      && data.products is map && data.products.size() <= 100
      && data.boostedCycles is map && data.boostedCycles.size() <= 100
      && data.tools is list && data.tools.size() <= 100
      && data.buildings is list && data.buildings.size() <= 100
      && data.decor is list && data.decor.size() <= 100
      && data.activeCrafts is list && data.activeCrafts.size() <= 100
      && data.transactions is list && data.transactions.size() <= 60
      && data.animalFeed is int && data.animalFeed >= 0 && data.animalFeed <= 1000000
      && data.waterUnits is int && data.waterUnits >= 0 && data.waterUnits <= 1000000
      && data.dailyStreak is int && data.dailyStreak >= 0 && data.dailyStreak <= 1000000
      && data.luckyStreak is int && data.luckyStreak >= 0 && data.luckyStreak <= 1000000
      && data.dailyProgress is map && data.dailyProgress.size() <= 100
      && data.lifetimeStats is map && data.lifetimeStats.size() <= 100
      && data.claimedDailyMissions is list && data.claimedDailyMissions.size() <= 100
      && data.claimedAchievements is list && data.claimedAchievements.size() <= 100
      && data.collect is map && data.collect.size() <= 100
      && data.plots is list && data.plots.size() >= 9 && data.plots.size() <= 24
      && data.updated is int
      && (!('legacyUnverified' in data) || data.legacyUnverified is bool)
      && (!('legacyImportedAt' in data) || (data.legacyImportedAt is string && data.legacyImportedAt.size() <= 64))
      && (!('lastOfflineRewardMessage' in data) || (data.lastOfflineRewardMessage is string && data.lastOfflineRewardMessage.size() <= 200));
    }

    function validFriendRecord(data, friendUid) {
      return data.keys().hasOnly(['uid', 'addedAt'])
        && data.uid == friendUid
        && data.addedAt == request.time;
    }

    function isExistingFriend(uid) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(uid)/friends/$(request.auth.uid));
    }

    function hasValidIncomingFriendRequest(receiverUid, senderUid) {
      let requestPath = /databases/$(database)/documents/users/$(receiverUid)/friendRequests/$(senderUid);
      return exists(requestPath)
        && get(requestPath).data.keys().hasOnly(['fromUid', 'fromName', 'toUid', 'createdAt', 'status'])
        && get(requestPath).data.fromUid == senderUid
        && get(requestPath).data.toUid == receiverUid
        && get(requestPath).data.status == 'pending'
        && get(requestPath).data.createdAt is timestamp
        && get(requestPath).data.fromName is string;
    }

    function validPublicProfile(data, uid) {
      return data.keys().hasOnly(['uid', 'name', 'updated'])
        && data.uid == uid
        && data.name is string && data.name.size() > 0 && data.name.size() <= 24
        && data.updated is int;
    }

    function validFarmSnapshot(data, uid) {
      return data.keys().hasOnly(['uid', 'name', 'plots', 'updated'])
        && data.uid == uid
        && data.name is string && data.name.size() <= 24
        && data.plots is list && data.plots.size() >= 9 && data.plots.size() <= 24
        && data.updated is int;
    }

    // Main game save: a player can access only their own record.
    match /users/{uid} {
      allow read: if owns(uid);
      allow create, update: if owns(uid) && validSave(request.resource.data);
      allow delete: if false;

      match /friends/{friendUid} {
        allow read: if owns(uid)
          || (signedIn()
            && request.auth.uid == friendUid
            && exists(/databases/$(database)/documents/users/$(friendUid)/friendRequests/$(uid)));

        allow create: if signedIn()
          && uid != friendUid
          && validFriendRecord(request.resource.data, friendUid)
          && (
            (owns(uid) && hasValidIncomingFriendRequest(uid, friendUid))
            || (request.auth.uid == friendUid && hasValidIncomingFriendRequest(friendUid, uid))
          )
          && existsAfter(/databases/$(database)/documents/users/$(friendUid)/friends/$(uid))
          && getAfter(/databases/$(database)/documents/users/$(friendUid)/friends/$(uid)).data.uid == uid
          && getAfter(/databases/$(database)/documents/users/$(friendUid)/friends/$(uid)).data.addedAt == request.time;

        allow delete: if signedIn()
          && (owns(uid) || request.auth.uid == friendUid)
          && !existsAfter(/databases/$(database)/documents/users/$(friendUid)/friends/$(uid));
        allow update: if false;
      }

      match /friendRequests/{fromUid} {
        allow read: if owns(uid) || (signedIn() && request.auth.uid == fromUid);
        allow create: if signedIn()
          && fromUid == request.auth.uid
          && uid != request.auth.uid
          && exists(/databases/$(database)/documents/publicProfiles/$(uid))
          && !exists(/databases/$(database)/documents/users/$(uid)/friends/$(fromUid))
          && request.resource.data.keys().hasOnly(['fromUid', 'fromName', 'toUid', 'createdAt', 'status'])
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.toUid == uid
          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt == request.time
          && request.resource.data.fromName is string
          && request.resource.data.fromName.size() <= 24
          && get(/databases/$(database)/documents/publicProfiles/$(fromUid)).data.name == request.resource.data.fromName
          && getAfter(/databases/$(database)/documents/users/$(fromUid)/sentRequests/$(uid)).data.fromUid == fromUid
          && getAfter(/databases/$(database)/documents/users/$(fromUid)/sentRequests/$(uid)).data.toUid == uid
          && getAfter(/databases/$(database)/documents/users/$(fromUid)/sentRequests/$(uid)).data.status == 'pending';
        allow delete: if signedIn()
          && (owns(uid) || request.auth.uid == fromUid)
          && !existsAfter(/databases/$(database)/documents/users/$(fromUid)/sentRequests/$(uid));
        allow update: if false;
      }

      match /sentRequests/{toUid} {
        allow read: if owns(uid);
        allow create: if owns(uid)
          && toUid != uid
          && exists(/databases/$(database)/documents/publicProfiles/$(toUid))
          && !exists(/databases/$(database)/documents/users/$(uid)/friends/$(toUid))
          && request.resource.data.keys().hasOnly(['fromUid', 'fromName', 'toUid', 'toName', 'createdAt', 'status'])
          && request.resource.data.fromUid == uid
          && request.resource.data.toUid == toUid
          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt == request.time
          && request.resource.data.fromName is string
          && request.resource.data.fromName.size() <= 24
          && request.resource.data.toName is string
          && request.resource.data.toName.size() <= 24
          && get(/databases/$(database)/documents/publicProfiles/$(toUid)).data.name == request.resource.data.toName
          && getAfter(/databases/$(database)/documents/users/$(toUid)/friendRequests/$(uid)).data.fromUid == uid
          && getAfter(/databases/$(database)/documents/users/$(toUid)/friendRequests/$(uid)).data.toUid == toUid
          && getAfter(/databases/$(database)/documents/users/$(toUid)/friendRequests/$(uid)).data.status == 'pending';
        allow delete: if signedIn()
          && (owns(uid) || request.auth.uid == toUid)
          && !existsAfter(/databases/$(database)/documents/users/$(toUid)/friendRequests/$(uid));
        allow update: if false;
      }
    }

    // Public identity only; balances and private game state are never published here.
    match /publicProfiles/{uid} {
      allow read: if signedIn();
      allow create, update: if owns(uid) && validPublicProfile(request.resource.data, uid);
      allow delete: if false;
    }

    // Farm layouts are visible only to the owner and accepted friends.
    match /farmSnapshots/{uid} {
      allow read: if owns(uid) || isExistingFriend(uid);
      allow create, update: if owns(uid) && validFarmSnapshot(request.resource.data, uid);
      allow delete: if false;
    }
  }
}
