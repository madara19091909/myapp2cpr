rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validSave(data) {
      return data.keys().hasOnly([
        'name', 'money', 'gold', 'xp', 'level', 'seeds', 'harvestedCrops',
        'animals', 'animalFeed', 'waterUnits', 'boostedCycles', 'tools',
        'transactions', 'lastDailyRewardDate', 'dailyStreak', 'dailyProgressDate',
        'dailyProgress', 'claimedDailyMissions', 'lifetimeStats',
        'claimedAchievements', 'collect', 'plots', 'updated'
      ])
      && data.name is string && data.name.size() <= 24
      && data.money is int && data.money >= 0 && data.money <= 2000000000
      && data.gold is int && data.gold >= 0 && data.gold <= 1000000
      && data.xp is int && data.xp >= 0 && data.xp <= 1000000000
      && data.level is int && data.level >= 1 && data.level <= 1000000
      && data.plots is list && data.plots.size() <= 24
      && data.updated is int;
    }

    function validFriendRecord(data, friendUid) {
      return data.keys().hasOnly(['uid', 'addedAt'])
        && data.uid == friendUid;
    }

    match /users/{uid} {
      // بيانات المزرعة الخاصة لا يقرأها ولا يكتبها إلا صاحب الحساب.
      // تنبيه: السماح للعميل بتعديل رصيده ضمن الحدود لا يمنع الغش؛ الاقتصاد التنافسي يحتاج Backend موثوقاً.
      allow read: if owns(uid);
      allow create, update: if owns(uid) && validSave(request.resource.data);
      allow delete: if false;

      match /friends/{friendUid} {
        // قراءة سجل الطرف الآخر مسموحة فقط أثناء قبول طلب موجود، لتكوين العلاقة من الطرفين.
        allow read: if owns(uid)
          || (signedIn()
            && request.auth.uid == friendUid
            && exists(/databases/$(database)/documents/users/$(friendUid)/friendRequests/$(uid)));

        allow create: if signedIn()
          && uid != friendUid
          && validFriendRecord(request.resource.data, friendUid)
          && (owns(uid)
            || (request.auth.uid == friendUid
              && exists(/databases/$(database)/documents/users/$(friendUid)/friendRequests/$(uid))));

        // حذف العلاقة من الطرف الآخر مسموح فقط إذا كان المستخدم يملك السجل المقابل.
        allow delete: if owns(uid)
          || (signedIn()
            && request.auth.uid == friendUid
            && exists(/databases/$(database)/documents/users/$(friendUid)/friends/$(uid)));
        allow update: if false;
      }

      match /friendRequests/{fromUid} {
        // المستلم يرى صندوق الوارد، والمرسل يستطيع قراءة/إلغاء طلبه الموجود باسمه فقط.
        allow read: if owns(uid) || (signedIn() && request.auth.uid == fromUid);
        allow create: if signedIn()
          && fromUid == request.auth.uid
          && uid != request.auth.uid
          && request.resource.data.keys().hasOnly(['fromUid', 'fromName', 'toUid', 'createdAt', 'status'])
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.toUid == uid
          && request.resource.data.status == 'pending'
          && request.resource.data.fromName is string
          && request.resource.data.fromName.size() <= 24;
        allow delete: if owns(uid) || (signedIn() && request.auth.uid == fromUid);
        allow update: if false;
      }

      match /sentRequests/{toUid} {
        allow read: if owns(uid);
        allow create: if owns(uid)
          && toUid != uid
          && request.resource.data.keys().hasOnly(['fromUid', 'fromName', 'toUid', 'toName', 'createdAt', 'status'])
          && request.resource.data.fromUid == uid
          && request.resource.data.toUid == toUid
          && request.resource.data.status == 'pending'
          && request.resource.data.fromName is string
          && request.resource.data.fromName.size() <= 24
          && request.resource.data.toName is string
          && request.resource.data.toName.size() <= 24;
        // المستلم يستطيع إزالة النسخة الصادرة فقط عند وجود طلبه الوارد المقابل.
        allow delete: if owns(uid)
          || (signedIn()
            && request.auth.uid == toUid
            && exists(/databases/$(database)/documents/users/$(toUid)/friendRequests/$(uid)));
        allow update: if false;
      }
    }

    match /publicProfiles/{uid} {
      // أسماء اللاعبين ولقطات المزارع وبيانات لوحة الشرف للعرض فقط.
      allow read: if signedIn();
      allow create, update: if owns(uid)
        && request.resource.data.keys().hasOnly([
          'uid', 'name', 'level', 'money', 'farmPlots', 'updated'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 40
        && request.resource.data.level is int
        && request.resource.data.level >= 1
        && request.resource.data.level <= 1000000
        && request.resource.data.money is int
        && request.resource.data.money >= 0
        && request.resource.data.money <= 2000000000
        && request.resource.data.updated is int
        && request.resource.data.farmPlots is list
        && request.resource.data.farmPlots.size() <= 24;
      allow delete: if false;
    }
  }
}
